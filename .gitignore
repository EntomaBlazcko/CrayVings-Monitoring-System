# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables
# Every .env* variant except the committed template is ignored, so real
# credentials can never be staged again (e.g. .env.new, .env.production).
.env
.env.*
!.env.example

# Scratch session notes. These are working documents, not deliverables, and
# have previously captured live credentials in plaintext.
FOR_LATER.txt
SESSION_NOTES.txt
*_NOTES.txt

# Database artifacts. A pg_dump is schema plus whatever rows were selected, so
# committing one is how credentials, emails, and phone numbers end up in git.
*.dump
*.sql
pgdata/
pgdata*/

# Local agent/editor state. None of this belongs in the repo: prompts and plans
# are working documents, and .opencode/ can hold server logs and DB backups.
.claude/
.qodo/
.opencode/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
