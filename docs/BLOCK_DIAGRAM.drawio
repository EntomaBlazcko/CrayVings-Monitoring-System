        <mxCell id="sw1" value="" style="rounded=0;html=1;fillColor=#D6F5D6;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="58" y="1205" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="lb1" value="1 &#183; Sensor / field layer" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="1201" width="210" height="32" as="geometry" /></mxCell>
        <mxCell id="sw2" value="" style="rounded=0;html=1;fillColor=#ECECEC;strokeColor=#616161;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="310" y="1205" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="lb2" value="2 &#183; Network layer" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="342" y="1201" width="210" height="32" as="geometry" /></mxCell>
