        <mxCell id="lb3" value="3 &#183; Application layer" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="594" y="1201" width="210" height="32" as="geometry" /></mxCell>
        <mxCell id="sw4" value="" style="rounded=0;html=1;fillColor=#EDE1F5;strokeColor=#5E35B1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="814" y="1205" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="lb4" value="4 &#183; Data layer" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="846" y="1201" width="210" height="32" as="geometry" /></mxCell>
        <mxCell id="sw5" value="" style="rounded=0;html=1;fillColor=#FFE8CC;strokeColor=#E65100;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1066" y="1205" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="lb5" value="5 &#183; Presentation layer" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1098" y="1201" width="210" height="32" as="geometry" /></mxCell>
        <mxCell id="sw6" value="" style="rounded=0;html=1;fillColor=#FFF4CE;strokeColor=#F9A825;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1318" y="1205" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="lb6" value="6 &#183; External services" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="1201" width="210" height="32" as="geometry" /></mxCell>
        <mxCell id="sw7" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#616161;strokeWidth=1.5;dashed=1;dashPattern=4 4;" vertex="1" parent="1"><mxGeometry x="1570" y="1205" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="lb7" value="Dashed border = optional / test-only / out-of-process component" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1602" y="1201" width="440" height="32" as="geometry" /></mxCell>
        <mxCell id="sw8" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#616161;strokeWidth=1.5;dashed=1;dashPattern=8 8;" vertex="1" parent="1"><mxGeometry x="2060" y="1205" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="lb8" value="Dashed edge = control / management / non-payload flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2092" y="1201" width="420" height="32" as="geometry" /></mxCell>

        <mxCell id="n1" value="&lt;b&gt;Two data directions.&lt;/b&gt; Sensor telemetry is push-only: the server never writes a sensor row on a device&#8217;s behalf, so a stale reading can never masquerade as a health check. Device health is a separate read-only poll of GET /status, which updates only devices.last_health_seen." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="58" y="1252" width="810" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;Real-time path.&lt;/b&gt; Every accepted reading is broadcast to all connected dashboards over SSE, so the UI updates instantly without polling. Polling is reserved for fleet status (5 s) and chart history (30 s). Both back off exponentially on failure and pause while the browser tab is hidden." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="888" y="1252" width="810" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Not depicted.&lt;/b&gt; The system uses no MQTT broker, no WebSocket transport, no cloud service beyond HTTPSMS/SMTP, and no machine-learning model. Analytics are SQL aggregation plus rule-based insight generation. Base-table DDL is not in version control&#8212;migrations 001&#8211;017 assume pre-existing tables and are run manually." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1718" y="1252" width="810" height="105" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>