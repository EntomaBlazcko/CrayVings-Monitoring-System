<mxfile host="app.diagrams.net" agent="opencode" version="24.7.17" type="device">
  <diagram id="crayvings-overview" name="System Block Diagram">
    <mxGraphModel dx="2400" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="CRAYvings Aquaculture Monitoring System &#8212; System Block Diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2A37;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Star topology: one ESP32 per tank (max 6) &#8594; single Express/PostgreSQL server &#8594; real-time React dashboard" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#5F6B7A;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1200" height="26" as="geometry" />
        </mxCell>

        <mxCell id="L1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8F2;strokeColor=#2E7D32;strokeWidth=1.5;dashed=1;dashPattern=8 8;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="360" height="620" as="geometry" />
        </mxCell>
        <mxCell id="L1h" value="1 &#183; SENSOR / FIELD LAYER" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#FFFFFF;fillColor=#2E7D32;strokeColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="360" height="36" as="geometry" />
        </mxCell>

        <mxCell id="b_tank" value="&lt;b&gt;Water Tank (T1 &#8211; T6)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;Crayfish / aquaculture production&lt;/font&gt;&lt;br&gt;device_id: tank01 &#8230; tank06" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="58" y="120" width="324" height="78" as="geometry" />
        </mxCell>

        <mxCell id="b_ds" value="&lt;b&gt;DS18B20&lt;/b&gt;&lt;br&gt;Digital temperature&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;GPIO13 &#183; OneWire&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;fillColor=#D6F5D6;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="58" y="220" width="100" height="76" as="geometry" />
        </mxCell>
        <mxCell id="b_hc" value="&lt;b&gt;HC-SR04&lt;/b&gt;&lt;br&gt;Ultrasonic water level&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;GPIO26/27&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;fillColor=#D6F5D6;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="168" y="220" width="100" height="76" as="geometry" />
        </mxCell>
        <mxCell id="b_mq" value="&lt;b&gt;MQ-137&lt;/b&gt;&lt;br&gt;NH&#8323; gas / ammonia&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;GPIO34 analog&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;fillColor=#D6F5D6;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="278" y="220" width="104" height="76" as="geometry" />
        </mxCell>

        <mxCell id="b_esp" value="&lt;b&gt;ESP32 DevKit V1 Controller&lt;/b&gt; (one per tank, .ino firmware)&lt;br&gt;&#8226; Samples all three sensors on a timer (FreeRTOS task)&lt;br&gt;&#8226; Pushes readings over HTTP every 1000 ms&lt;br&gt;&#8226; X-Device-Secret header (shared or per-device secret)&lt;br&gt;&#8226; 600-entry drop-proof ring buffer &#8212; flushes oldest-first on reconnect&lt;br&gt;&#8226; Task watchdog + safe-mode boot recovery&lt;br&gt;&#8226; WiFiManager config portal; 480&#215;320 TFT + XPT2046 touch&lt;br&gt;&#8226; Converts sensor-failure sentinels (&#8722;1 / 0) before sending" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#D6F5D6;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="58" y="316" width="324" height="214" as="geometry" />
        </mxCell>

        <mxCell id="b_mock" value="&lt;b&gt;Mock ESP32 Simulator&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;scripts/mock-device.js &#183; bench testing without hardware&lt;/font&gt;&lt;br&gt;&#8226; Replays scripted / random readings per tank&lt;br&gt;&#8226; Simulates drops, reconnects and disconnects" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#F5FBF5;strokeColor=#66BB6A;strokeWidth=1.5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="58" y="550" width="324" height="120" as="geometry" />
        </mxCell>

        <mxCell id="L2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#616161;strokeWidth=1.5;dashed=1;dashPattern=8 8;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="200" height="620" as="geometry" />
        </mxCell>
        <mxCell id="L2h" value="2 &#183; NETWORK" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#FFFFFF;fillColor=#616161;strokeColor=#424242;" vertex="1" parent="1">
          <mxGeometry x="440" y="60" width="200" height="36" as="geometry" />
        </mxCell>

        <mxCell id="b_transport" value="&lt;b&gt;HTTP Transport&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&#8593; POST /sensor&lt;/b&gt;&lt;br&gt;device &#8594; server, 1 Hz&lt;br&gt;X-Device-Secret auth&lt;br&gt;rate-limited 12 s&#8315;&#185;/device&lt;br&gt;&lt;br&gt;&lt;b>&#8595; GET /status&lt;/b&gt;&lt;br&gt;server &#8594; device, read-only&lt;br&gt;ESPAsyncWebServer :80&lt;br&gt;diagnostics JSON" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#ECECEC;strokeColor=#616161;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="455" y="120" width="170" height="250" as="geometry" />
        </mxCell>

        <mxCell id="b_lan" value="&lt;b&gt;LAN Addressing&lt;/b&gt;&lt;br&gt;&lt;br&gt;192.168.4.0/24&lt;br&gt;&lt;br&gt;&#8226; AP / router &#8212; .1&lt;br&gt;&#8226; Server &#8212; .10&lt;br&gt;&#8226; ESP32 T1 &#8212; .100&lt;br&gt;&#8226; ESP32 T2 &#8212; .101&lt;br&gt;&#8226; &#8230;&#8217;&#8230;&#8217;&lt;br&gt;&#8226; ESP32 T6 &#8212; .105&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;Static IP per device&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="455" y="400" width="170" height="230" as="geometry" />
        </mxCell>

        <mxCell id="L3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FD;strokeColor=#1565C0;strokeWidth=1.5;dashed=1;dashPattern=8 8;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="680" y="80" width="580" height="1040" as="geometry" />
        </mxCell>
        <mxCell id="L3h" value="3 &#183; APPLICATION LAYER &#8212; Express 5 API (Node.js, server.cjs)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#FFFFFF;fillColor=#1565C0;strokeColor=#0D47A1;" vertex="1" parent="1">
          <mxGeometry x="680" y="60" width="580" height="36" as="geometry" />
        </mxCell>

        <mxCell id="b_mw" value="&lt;b&gt;Cross-Cutting Middleware&lt;/b&gt; (applies to every block below)&lt;br&gt;&#8226; helmet CSP &#183; CORS allowlist &#183; rate limiting (global 300 req/min/IP, login 5/15 min)&lt;br&gt;&#8226; Zod request validation &#183; JSON 404/error envelope &#183; request audit logging" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#E3ECFA;strokeColor=#1565C0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="698" y="989" width="546" height="100" as="geometry" />
        </mxCell>

        <mxCell id="b_ingest" value="&lt;b&gt;Ingestion &amp;amp; Validation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;POST /sensor&lt;/font&gt;&lt;br&gt;&#8226; Accepts tank01&#8211;tank06 payload&lt;br&gt;&#8226; Zod schema validation&lt;br&gt;&#8226; Sentinels (&#8722;1 / 0) &#8594; NULL&lt;br&gt;&#8226; Range check + ammonia-spike guard&lt;br&gt;&#8226; Burst headroom for offline flush" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#DCE9FB;strokeColor=#1565C0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="698" y="125" width="268" height="112" as="geometry" />
        </mxCell>

        <mxCell id="b_devauth" value="&lt;b&gt;Device Authentication&lt;/b&gt;&lt;br&gt;&#8226; Shared DEVICE_SECRET fallback&lt;br&gt;&#8226; Per-device device_secret&lt;br&gt;&#8226; device_secret_prev accepted&lt;br&gt;   within the rotation grace window&lt;br&gt;&#8226; Case-insensitive device_id match&lt;br&gt;&#8226; Secrets never leave the database" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#DCE9FB;strokeColor=#1565C0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="976" y="125" width="268" height="112" as="geometry" />
        </mxCell>

        <mxCell id="b_persist" value="&lt;b&gt;Persistence &#8212; Change-Only (Delta) Logging&lt;/b&gt;&lt;br&gt;&#8226; Compares against the last stored reading per device&lt;br&gt;&#8226; Changed &#8594; INSERT row &#183; Unchanged &#8594; UPDATE devices.last_seen only, reply {skipped:true}&lt;br&gt;&#8226; Tolerances: temp &#177;0.1&#176;C &#183; level &#177;1.0% &#183; NH&#8323; &#177;0.05 ppm" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#DCE9FB;strokeColor=#1565C0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="698" y="253" width="546" height="96" as="geometry" />
        </mxCell>

        <mxCell id="b_alert" value="&lt;b&gt;Threshold &amp;amp; Alert Engine&lt;/b&gt;&lt;br&gt;&#8226; Evaluates global + per-tank overrides&lt;br&gt;&#8226; Classifies severity: info / warning / critical&lt;br&gt;&#8226; Deduplicates via last_alerts (survives restart)&lt;br&gt;&#8226; Disconnect detection on the 30 s stale window&lt;br&gt;   with a rearm grace period against flapping&lt;br&gt;&#8226; Writes system_logs + activity_logs" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#DCE9FB;strokeColor=#1565C0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="698" y="365" width="268" height="132" as="geometry" />
        </mxCell>

        <mxCell id="b_notify" value="&lt;b&gt;Notification Dispatcher&lt;/b&gt;&lt;br&gt;&#8226; Fans out to active SMS recipients&lt;br&gt;&#8226; Respects global + per-tank SMS mute&lt;br&gt;&#8226; Enforces the daily send cap and cooldown&lt;br&gt;&#8226; Records per-message status in sms_logs&lt;br&gt;&#8226; Hourly fleet status SMS (optional)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#DCE9FB;strokeColor=#1565C0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="976" y="365" width="268" height="132" as="geometry" />
        </mxCell>

        <mxCell id="b_sse" value="&lt;b&gt;Real-Time Fan-Out (Server-Sent Events)&lt;/b&gt;&lt;br&gt;GET /sensor/stream &#183; every accepted reading is broadcast to all connected dashboards&lt;br&gt;Token passed as a query parameter (EventSource cannot set headers) &#183; 25 s keep-alive pings" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#CFE3FB;strokeColor=#0D47A1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="698" y="513" width="546" height="96" as="geometry" />
        </mxCell>

        <mxCell id="b_analytics" value="&lt;b&gt;Analytics &amp;amp; Reporting&lt;/b&gt;&lt;br&gt;&#8226; SQL aggregation (avg / min / max, day-over-day trend)&lt;br&gt;&#8226; Weekly + arbitrary-range reports (hourly buckets &lt;=24 h, else daily)&lt;br&gt;&#8226; Rule-based insight generation&#8212;no ML service" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#DCE9FB;strokeColor=#1565C0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="698" y="625" width="268" height="116" as="geometry" />
        </mxCell>

        <mxCell id="b_users" value="&lt;b&gt;Users, Roles &amp;amp; Access Control&lt;/b&gt;&lt;br&gt;&#8226; PBKDF2-SHA512, 600 000 iterations + per-user salt&lt;br&gt;&#8226; 64-char session token, SHA-256 hashed at rest, 24 h expiry&lt;br&gt;&#8226; Two roles: admin (full) / user (read-only dashboards)&lt;br&gt;&#8226; OTP-verified account archive, restore and purge" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#DCE9FB;strokeColor=#1565C0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="976" y="625" width="268" height="116" as="geometry" />
        </mxCell>

        <mxCell id="b_boot" value="&lt;b&gt;Boot &amp;amp; State Recovery&lt;/b&gt;&lt;br&gt;startServer(): waits for the database (exponential backoff) &#8594; bootstraps the owner account if none exists &#8594; restores alert dedup state, SMS mute state, ammonia baselines and the in-memory latest readings from PostgreSQL, so a restart neither loses dedup state nor fires false disconnect alerts." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#DCE9FB;strokeColor=#1565C0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="698" y="757" width="546" height="92" as="geometry" />
        </mxCell>

        <mxCell id="b_poller" value="&lt;b&gt;devicePoller.cjs&lt;/b&gt;&lt;br&gt;Health-poll loop, max concurrency 10, 2 s timeout &#183; updates devices.last_health_seen &#183; writes no sensor rows by design" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#E8EEF7;strokeColor=#5C7FB8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="698" y="869" width="268" height="100" as="geometry" />
        </mxCell>

        <mxCell id="b_sms" value="&lt;b&gt;smsService.cjs &#8212; Circuit Breaker&lt;/b&gt;&lt;br&gt;CLOSED / OPEN / HALF_OPEN &#183; 5 consecutive failures trip, 60 s cooldown, then a single probe &#183; delivery-reconciliation poller runs outside the breaker" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#E8EEF7;strokeColor=#5C7FB8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="976" y="869" width="268" height="100" as="geometry" />
        </mxCell>

        <mxCell id="L4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F5FC;strokeColor=#5E35B1;strokeWidth=1.5;dashed=1;dashPattern=8 8;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1300" y="80" width="420" height="1040" as="geometry" />
        </mxCell>
        <mxCell id="L4h" value="4 &#183; DATA LAYER &#8212; PostgreSQL 15" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#FFFFFF;fillColor=#5E35B1;strokeColor=#4527A0;" vertex="1" parent="1">
          <mxGeometry x="1300" y="60" width="420" height="36" as="geometry" />
        </mxCell>

        <mxCell id="b_ts" value="&lt;b&gt;Time-Series&lt;/b&gt;&lt;br&gt;&lt;b&gt;sensors&lt;/b&gt; &#8212; the hot table&lt;br&gt;&#8226; tank01&#8211;tank06 &#215; timestamped readings&lt;br&gt;&#8226; temperature, water_level, ammonia (NULL = failed sensor)&lt;br&gt;&#8226; Keyset pagination, up to 1000 rows per read" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#EDE1F5;strokeColor=#5E35B1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1316" y="125" width="388" height="110" as="geometry" />
        </mxCell>

        <mxCell id="b_cfg" value="&lt;b&gt;Configuration &amp;amp; Device Registry&lt;/b&gt;&lt;br&gt;&lt;b&gt;devices&lt;/b&gt; &#8212; ESP32 registry: static IP, tank name, health timestamp, registration source, per-device secret + rotation quartet&lt;br&gt;&lt;b&gt;sensor_settings&lt;/b&gt; &#8212; global thresholds&lt;br&gt;&lt;b&gt;device_threshold_overrides&lt;/b&gt; &#8212; per-tank threshold overrides" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#EDE1F5;strokeColor=#5E35B1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1316" y="251" width="388" height="140" as="geometry" />
        </mxCell>

        <mxCell id="b_ident" value="&lt;b&gt;Identity &amp;amp; Audit Trail&lt;/b&gt;&lt;br&gt;&lt;b&gt;users&lt;/b> &#8212; accounts, PBKDF2 hashes, hashed session token, soft-delete lifecycle&lt;br&gt;&lt;b&gt;email_otps&lt;/b&gt; &#8212; hashed OTP codes with expiry&lt;br&gt;&lt;b&gt;user_deletion_requests&lt;/b&gt; &#8212; pending OTP-verified deletions&lt;br&gt;&lt;b&gt;activity_logs&lt;/b> &#8212; user interaction audit trail" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#EDE1F5;strokeColor=#5E35B1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1316" y="407" width="388" height="140" as="geometry" />
        </mxCell>

        <mxCell id="b_alertdb" value="&lt;b&gt;Alerting State&lt;/b&gt;&lt;br&gt;&lt;b&gt;system_logs&lt;/b&gt; &#8212; alert/event log with acknowledgement state and originating device&lt;br&gt;&lt;b&gt;last_alerts&lt;/b> &#8212; dedup state, restored on every boot" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#EDE1F5;strokeColor=#5E35B1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1316" y="563" width="388" height="110" as="geometry" />
        </mxCell>

        <mxCell id="b_msg" value="&lt;b&gt;Messaging State&lt;/b&gt;&lt;br&gt;&lt;b&gt;authorized_recipients&lt;/b> &#8212; SMS recipient registry with archive / restore&lt;br&gt;&lt;b&gt;sms_logs&lt;/b&gt; &#8212; per-message delivery status: queued / delivered / failed&lt;br&gt;&lt;b&gt;system_state&lt;/b> &#8212; key/value store for the global SMS mute and per-tank mutes" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#EDE1F5;strokeColor=#5E35B1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1316" y="689" width="388" height="140" as="geometry" />
        </mxCell>

        <mxCell id="b_meta" value="&lt;b&gt;Schema Versioning&lt;/b&gt;&lt;br&gt;&lt;b&gt;schema_migrations&lt;/b&gt; &#8212; records which of the 17 migration scripts have been applied" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#EDE1F5;strokeColor=#5E35B1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1316" y="845" width="388" height="110" as="geometry" />
        </mxCell>

        <mxCell id="b_pool" value="&lt;b>Connection Management&lt;/b&gt;&lt;br&gt;pg.Pool &#8212; max 20 connections, 30 s idle timeout, 5 s connect timeout &#183; pool errors are logged and never fatal &#183; 14 tables total, foreign keys enforced, CHECK constraints keep NULL sentinels out" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#F3EDF9;strokeColor=#9575CD;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1316" y="971" width="388" height="110" as="geometry" />
        </mxCell>

        <mxCell id="L5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7F0;strokeColor=#E65100;strokeWidth=1.5;dashed=1;dashPattern=8 8;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1760" y="80" width="420" height="1040" as="geometry" />
        </mxCell>
        <mxCell id="L5h" value="5 &#183; PRESENTATION LAYER &#8212; React 19 + TypeScript" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#FFFFFF;fillColor=#E65100;strokeColor=#BF360C;" vertex="1" parent="1">
          <mxGeometry x="1760" y="60" width="420" height="36" as="geometry" />
        </mxCell>

        <mxCell id="b_authctx" value="&lt;b&gt;AuthContext&lt;/b&gt;&lt;br&gt;&#8226; Session state, role-aware sidebar and menu&lt;br&gt;&#8226; Bearer token in localStorage, injected by an Axios interceptor&lt;br&gt;&#8226; Login / logout / password change" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#FFE8CC;strokeColor=#E65100;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1776" y="125" width="388" height="104" as="geometry" />
        </mxCell>

        <mxCell id="b_prov" value="&lt;b&gt;SensorProvider &#8212; Real-Time Transport&lt;/b&gt;&lt;br&gt;&#8226; SSE subscription for the selected tank, exponential reconnect capped at 30 s&lt;br&gt;&#8226; REST /sensor/latest fallback on mount&lt;br&gt;&#8226; Fleet registry (GET /devices) and per-tank live values (GET /devices/latest) every 5 s&lt;br&gt;&#8226; Chart history every 30 s &#183; both polls back off on failure and pause when the tab is hidden" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#FFE8CC;strokeColor=#E65100;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1776" y="245" width="388" height="160" as="geometry" />
        </mxCell>

        <mxCell id="b_pages" value="&lt;b&gt;Pages (menu-state routing, lazy-loaded)&lt;/b&gt;&lt;br&gt;&#8226; Dashboard &#8212; farm overview grid, stat cards, trend cards, tank selector, fleet alarms&lt;br&gt;&#8226; Sensors &#8212; current values against effective thresholds&lt;br&gt;&#8226; Alerts &#8212; acknowledge, resolve, mute per tank&lt;br&gt;&#8226; Analytics &#8212; overview, daily series, rule-based insights&lt;br&gt;&#8226; Historical Data &#8212; keyset-paginated readings&lt;br&gt;&#8226; Sensor Logs &#8212; sensor and system log stream&lt;br&gt;&#8226; Activity Logs &#8212; user audit trail (admin)&lt;br&gt;&#8226; Devices &#8212; register, rename, hide, live-check, rotate secret, archive (admin)&lt;br&gt;&#8226; Settings &#8212; thresholds, recipients, SMS mute, users (admin)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#FFE8CC;strokeColor=#E65100;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1776" y="421" width="388" height="200" as="geometry" />
        </mxCell>

        <mxCell id="b_viz" value="&lt;b&gt;Visualisation, Alerts &amp;amp; Export&lt;/b&gt;&lt;br>&#8226; Recharts for live trends and analytics series&lt;br>&#8226; useThresholdAlert + useFleetAlarms &#8594; two-tier alerting&lt;br&gt;&#8226; CriticalAlarmBanner and FloatingAlert overlays&lt;br>&#8226; Alert audio (critical / warning / high / low mp3s, unlocked on first gesture)&lt;br>&#8226; jsPDF + autoTable report export" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#FFE8CC;strokeColor=#E65100;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1776" y="637" width="388" height="150" as="geometry" />
        </mxCell>

        <mxCell id="b_static" value="&lt;b&gt;Static Asset Host&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6B7A&quot;&gt;Vite production build output (dist/) &#8212; chunked: react, recharts, jsPDF, html2canvas&lt;/font&gt;&lt;br&gt;Delivered by a separate static host or reverse proxy." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#FFF3E8;strokeColor=#F57C00;strokeWidth=1.5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1776" y="803" width="388" height="130" as="geometry" />
        </mxCell>

        <mxCell id="b_note1" value="&lt;b&gt;Deployment note&lt;/b&gt;&lt;br&gt;server.cjs contains no express.static / sendFile route, so it serves the API only. The committed dist/ build is served by an external static host or reverse proxy. This block represents that host." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#F57C00;strokeWidth=1.5;" vertex="1" parent="1">
