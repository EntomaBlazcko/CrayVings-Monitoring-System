# Server Configuration
PORT=3000
NODE_ENV=development

# =============================================================================
# SMTP (Email) Configuration - used to email deletion-request OTP codes.
# Leave SMTP_HOST empty to disable SMTP; in development the 6-digit code is
# printed to the server console instead of emailed (DEV_OTP_CONSOLE_FALLBACK).
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@example.com

# In development with no SMTP configured, log the OTP to console so the
# verified-deletion flow can be exercised end-to-end. Set to false in prod.
DEV_OTP_CONSOLE_FALLBACK=true


# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=crayvings_monitoring_system_db
PG_USER=postgres
PG_PASSWORD=your_password_here

# CORS - Add your frontend URLs here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Device secret shared with the ESP32 (X-Device-Secret header).
# When set, POST /sensor rejects requests without a matching secret.
# Enter the same value on the ESP32 (device_secret config). Leave blank in dev.
DEVICE_SECRET=change_me_shared_secret

# Admin initial password (REQUIRED for first-time setup when no admin exists)
# Existing admin passwords are never overwritten by seeding.
# Set a strong value; the plaintext is never logged or shown in the UI.
ADMIN_INITIAL_PASSWORD=change_me_strong_password

# Arduino Serial Configuration (optional)
ARDUINO_ENABLED=false
ARDUINO_PORT=COM3
ARDUINO_BAUD=19200
DEVICE_ID=ARDUINO_001
POLL_INTERVAL=1000

# =============================================================================
# SMTP (Email) Configuration — secure account deletion (email OTP)
# =============================================================================
# Required when SMTP_HOST is set to actually deliver the 6-digit confirmation
# code that verifies an admin-initiated user deletion. Without SMTP, the server
# falls back to logging the code to the console in dev (DEV_OTP_CONSOLE_FALLBACK).
#
#   SMTP_HOST    - Your SMTP server hostname (e.g. smtp.gmail.com)
#   SMTP_PORT    - Port (587 STARTTLS, 465 implicit TLS)
#   SMTP_SECURE  - true for implicit TLS (465); false for STARTTLS (587)
#   SMTP_USER    - Auth username (often the mailbox address)
#   SMTP_PASS    - Auth password or app-specific password
#   SMTP_FROM    - "From" address; falls back to SMTP_USER if omitted
#   SMTP_CREATE_TRANSPORT_ON_STARTUP - set true to require nodemailer at boot
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_CREATE_TRANSPORT_ON_STARTUP=false

# When a mail provider is not configured, print OTP codes to the console so the
# flow can be tested in development (NOT recommended in production).
DEV_OTP_CONSOLE_FALLBACK=true