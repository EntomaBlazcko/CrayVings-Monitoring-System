# Server Configuration
PORT=3000
NODE_ENV=development

# =============================================================================
# SMTP (Email) Configuration - used to email deletion-request OTP codes.
# Leave SMTP_HOST empty to disable SMTP; in development the 6-digit code is
# printed to the server console instead of emailed (DEV_OTP_CONSOLE_FALLBACK).
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@example.com

# In development with no SMTP configured, log the OTP to console so the
# verified-deletion flow can be exercised end-to-end. Set to false in prod.
DEV_OTP_CONSOLE_FALLBACK=true


# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=crayvings_monitoring_system_db
PG_USER=postgres
PG_PASSWORD=your_password_here

# CORS - Add your frontend URLs here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Device secret shared with the ESP32 (X-Device-Secret header).
# When set, POST /sensor rejects requests without a matching secret.
# Enter the same value on the ESP32 (device_secret config). Leave blank in dev.
DEVICE_SECRET=change_me_shared_secret

# Admin initial password (REQUIRED for first-time setup when no admin exists)
# Existing admin passwords are never overwritten by seeding.
# Set a strong value; the plaintext is never logged or shown in the UI.
ADMIN_INITIAL_PASSWORD=change_me_strong_password

# Owner admin account — the sole privileged account, never a hardcoded default.
# Bootstrapped ONLY when no admin-role user exists. The owner cannot be deleted,
# and this mailbox receives the deletion OTP + completion notifications.
ADMIN_USERNAME=owner
ADMIN_EMAIL=your_gmail@gmail.com
ADMIN_NAME=Owner

# Arduino Serial Configuration (optional)
ARDUINO_ENABLED=false
ARDUINO_PORT=COM3
ARDUINO_BAUD=19200
DEVICE_ID=ARDUINO_001
POLL_INTERVAL=1000

# =============================================================================
# SMTP (Email) Configuration — secure account deletion (email OTP)
# =============================================================================
# Required when SMTP_HOST is set to actually deliver the 6-digit confirmation
# code that verifies an admin-initiated user deletion. Without SMTP, the server
# falls back to logging the code to the console in dev (DEV_OTP_CONSOLE_FALLBACK).
#
#   SMTP_HOST    - Your SMTP server hostname (e.g. smtp.gmail.com)
#   SMTP_PORT    - Port (587 STARTTLS, 465 implicit TLS)
#   SMTP_SECURE  - true for implicit TLS (465); false for STARTTLS (587)
#   SMTP_USER    - Auth username (often the mailbox address)
#   SMTP_PASS    - Auth password or app-specific password
#   SMTP_FROM    - "From" address; falls back to SMTP_USER if omitted
#   SMTP_CREATE_TRANSPORT_ON_STARTUP - set true to require nodemailer at boot
# Gmail defaults (with an app password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="My Farm Name <your_gmail@gmail.com>"
SMTP_CREATE_TRANSPORT_ON_STARTUP=false

# Where deletion-request OTP emails are sent. If set, overrides the target
# user's own email so the code lands in the owner's mailbox. Leave blank to
# send to the account being deleted.
OTP_EMAIL=your_gmail@gmail.com

# When a mail provider is not configured, print OTP codes to the console so the
# flow can be tested in development (NOT recommended in production).
DEV_OTP_CONSOLE_FALLBACK=true

# =============================================================================
# SMTP (Email) Configuration above is for the account-deletion OTP ONLY.
# SMS alerts below are delivered through HTTPSMS (https://httpsms.com) — a free,
# open-source service that turns an Android phone into an SMS gateway.
#
# Setup: install the HttpSms APK on an Android phone that holds the SIM, sign in,
# and copy your API key from https://httpsms.com/settings. The phone must stay
# online while sending.
# =============================================================================
# HTTPSMS_API_KEY - API key from https://httpsms.com/settings
# HTTPSMS_FROM    - the gateway SIM's number in E.164 form (PH: +639XXXXXXXXXX)
HTTPSMS_API_KEY=your_httpsms_api_key
HTTPSMS_FROM=+639XXXXXXXXXX

# Cooldown between repeated CRITICAL alert SMS per sensor (ms). Default 5 min.
SMS_COOLDOWN_MS=300000

# Hourly status SMS — current readings + threshold status to all recipients.
HOURLY_SMS_ENABLED=true
HOURLY_SMS_INTERVAL_MS=3600000

# Device-disconnect SMS — warn when a device's last reading is older than this.
DEVICE_DISCONNECT_ENABLED=true
DISCONNECT_STALE_MS=30000

# Reconnect grace: after a device recovers, it must stay online at least this
# long before a NEW disconnect SMS is allowed (stops flapping-ESP32 spam).
DISCONNECT_REARM_MS=300000

# Daily SMS budget across all producers (0 disables the cap). Once reached,
# further sends are recorded as 'capped' instead of going out. Test SMS bypass.
SMS_DAILY_CAP=100

# How often the server checks queued SMS against httpsms for delivered/failed.
SMS_DELIVERY_POLL_MS=45000

# How long to keep SMS history before purging (0 disables purging).
SMS_RETENTION_DAYS=30