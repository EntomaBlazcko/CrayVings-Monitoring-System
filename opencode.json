{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow",

      "**/.claude/**": "deny",
      "**/.qodo/**": "deny",
      "**/.opencode/**": "deny",
      "*.dump": "deny",
      "*.sql": "deny"
    },
    "edit": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "bash": {
      "*": "ask",

      "node server.cjs": "deny",
      "node server.cjs *": "deny",
      "node .\\server.cjs": "deny",
      "node ./server.cjs": "deny",
      "node *server.cjs": "deny",
      "node scripts/mock-device.js": "deny",
      "node scripts/mock-device.js *": "deny",
      "node *mock-device.js": "deny",
      "node tools/watch-connection.cjs": "deny",
      "node tools/watch-connection.cjs *": "deny",
      "node *watch-connection.cjs": "deny",
      "vite": "deny",
      "vite *": "deny",
      "npx vite": "deny",
      "npx vite *": "deny",
      "npm run dev": "deny",
      "npm run dev *": "deny",
      "npm run start": "deny",
      "npm run start *": "deny",
      "npm run server": "deny",
      "npm run server *": "deny",
      "npm run preview": "deny",
      "npm run preview *": "deny",
      "npm run mock": "deny",
      "npm run mock *": "deny",
      "npm run mock:profiles": "allow",
      "cmd /c npm run dev": "deny",
      "cmd /c npm start": "deny",
      "*restart-server*": "deny",
      "*restart_server*": "deny",
      "Start-Process*": "deny",
      "start-process*": "deny",
      "*server.cjs*": "deny",

      "rm *": "deny",
      "rmdir *": "deny",
      "del *": "deny",
      "Remove-Item*": "ask",
      "git push*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git rebase*": "deny",
      "git branch -D*": "deny",
      "git branch -d*": "deny",
      "git restore*": "deny",
      "git checkout --*": "deny",
      "git stash drop*": "deny",
      "git stash clear*": "deny",

      "git commit*": "ask",
      "npm install*": "ask",
      "npm i *": "ask",
      "npm ci*": "ask",
      "npm uninstall*": "ask",
      "psql*": "ask",
      "pg_dump*": "ask",
      "pg_restore*": "ask",
      "dropdb*": "ask",
      "createdb*": "ask",
      "node db/migrations/*": "ask",
      "node tests/*": "ask",
      "node seed-admin.cjs": "ask",
      "npm run seed:admin": "ask",
      "npm run test*": "ask",
      "npm run lint": "ask",
      "npm run build": "ask",
      "node --input-type=module -e*": "ask",
      "node -e*": "ask",

      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "Get-ChildItem": "allow",
      "Get-ChildItem *": "allow",
      "Get-Content *": "allow",
      "Select-String *": "allow",
      "Test-Path *": "allow"
    }
  }
}
